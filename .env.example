# Copy this file to .env and fill in your values for local development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/ggmaidan

# A long random string used to sign session cookies
SESSION_SECRET=change-me-to-something-random

# Admin panel password
ADMIN_PASSWORD=change-me

# (Optional) Only needed when running frontends separately from the API.
# Leave blank for local monorepo development — API calls use /api/ root-relative paths.
# VITE_API_URL=https://your-render-service.onrender.com
